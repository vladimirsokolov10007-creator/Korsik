# Режим демонстрации: true — бот работает без внешних ключей и использует безопасный локальный RAG.
DEMO_MODE=true
APP_NAME=Korsik 2.0
APP_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/korsik.db
KNOWLEDGE_BASE_PATH=./data/knowledge_base
RAG_MIN_SCORE=0.18

# Защита дашборда вне демо-режима. Сгенерируйте длинный случайный секрет.
DASHBOARD_ADMIN_TOKEN=replace_with_long_random_token

# GigaChat: секрет хранится ТОЛЬКО здесь, не в HTML и не в Git.
# Возьмите Authorization data в кабинете GigaChat.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=true
# Не включайте false в production. При необходимости задайте путь к approved CA bundle.
GIGACHAT_CA_BUNDLE=

# MAX: значения подтверждаются в кабинете разработчика MAX для созданного bot account.
MAX_BOT_TOKEN=
# Точный URL из документации MAX. Можно использовать {chat_id}, если API ожидает id в URL.
MAX_SEND_MESSAGE_URL=
# Где API MAX ждёт получателя: body, query или url_template.
MAX_RECIPIENT_LOCATION=body
MAX_RECIPIENT_FIELD=chat_id
# В production укажите секрет, который MAX передаёт в заголовке ниже.
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET_HEADER=X-Max-Webhook-Secret
# Имя заголовка авторизации outbound API. Обычно оставьте Authorization.
MAX_AUTH_HEADER=Authorization
# Шаблон значения авторизации. Поддерживается {token}; пример: Bearer {token}
MAX_AUTH_VALUE_TEMPLATE=Bearer {token}
# Оставьте false, пока не сверите JSON-схему интерактивных кнопок MAX в официальном кабинете.
MAX_SEND_INTERACTIVE_BUTTONS=false
# APP_BASE_URL укажите публичным URL после деплоя, например https://ваш-домен.

# Чат-регистрация через MAX. Команда /start запускает сбор только необходимых данных.
ONBOARDING_TIMEZONE=Europe/Moscow
